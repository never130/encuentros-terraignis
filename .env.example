# Copiar a .env.local para desarrollo. En Vercel se configuran en Settings → Environment Variables
# (la integración de Neon carga DATABASE_URL automáticamente).

# Conexión a Neon PostgreSQL (solo servidor)
DATABASE_URL=

# Contraseña compartida del panel /admin (HTTP Basic Auth; el usuario del diálogo se ignora).
# Sin esta variable el panel queda siempre cerrado.
ADMIN_PASSWORD=

# Email de confirmación por SMTP (cuenta Gmail dedicada). Solo servidor.
# SMTP_PASSWORD es una "contraseña de aplicación" de Google (16 letras), NO la clave de la cuenta.
# Sin SMTP_USER / SMTP_PASSWORD no se envía el email (la inscripción se guarda igual).
SMTP_USER=
SMTP_PASSWORD=
# Opcionales (valores por defecto para Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM_NAME=Encuentros Terra Ignis

# URL pública (opcional; por defecto https://encuentros-terraignis.vercel.app)
# NEXT_PUBLIC_SITE_URL=
